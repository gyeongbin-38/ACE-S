  "cards": [
    {
      "dot": "cyan",
      "title": "Core rule",
      "items": [
        "Do not maximize context; maximize sufficient trustworthy context",
        "If current context is enough, retrieval stops before it starts"
      ]
    },
    {
      "dot": "violet",
      "title": "Progressive disclosure",
      "items": [
        "Prefer path, symbol, index, and structure before broad semantic search",
        "Escalate fidelity only when the lower-resolution view is insufficient"
      ]
    },
    {
      "dot": "emerald",
      "title": "Sufficiency loop",
      "items": [
        "When evidence is insufficient, expand one narrow step and re-evaluate",
        "Summaries remain views; fidelity-critical facts route back to raw evidence"
      ]
    }
  ]
