{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ace-s://benchmarks/repo-evidence-witness-v0.1",
  "title": "ACE-S Repository Evidence Witness Task",
  "type": "object",
  "required": ["task_id", "repository", "commit_sha", "prompt", "expected_file", "witnesses"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "prompt": {"type": "string", "minLength": 1},
    "expected_file": {"type": "string", "minLength": 1},
    "witnesses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "start_line", "end_line", "kind", "claim", "minimum_visible_lines"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1},
          "kind": {
            "type": "string",
            "enum": ["definition", "implementation", "branch", "mutation", "callsite", "comment_contract"]
          },
          "claim": {"type": "string", "minLength": 1},
          "minimum_visible_lines": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "construction_note": {"type": "string"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "description": "Every witness path must equal expected_file and start_line must be <= end_line. These cross-field constraints are enforced by the benchmark validator because JSON Schema cannot express both portably here."
    }
  ]
}
